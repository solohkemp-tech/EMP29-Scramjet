{
  "name": "emp29-scramjet-browser",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "description": "EMP29 personal web browser powered by Scramjet",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server.mjs",
    "dev": "node --env-file-if-exists=.env server.mjs",
    "build": "node scripts/build.mjs",
    "test": "node --experimental-vm-modules --test tests/*.test.mjs",
    "check": "node scripts/check.mjs",
    "setup": "node scripts/setup.mjs",
    "doctor": "node --env-file-if-exists=.env scripts/doctor.mjs",
    "brand": "node scripts/brand-assets.mjs"
  },
  "dependencies": {
    "@mercuryworkshop/wisp-js": "0.5.0",
    "ipaddr.js": "2.5.0"
  },
  "devDependencies": {
    "@fontsource/vazirmatn": "5.3.0",
    "@mercuryworkshop/epoxy-transport": "3.0.1",
    "@mercuryworkshop/libcurl-transport": "2.0.5",
    "@mercuryworkshop/scramjet": "2.0.67-alpha.2",
    "@mercuryworkshop/scramjet-controller": "0.0.14",
    "@mozilla/readability": "0.6.0",
    "acorn": "8.19.0",
    "binaryen": "132.0.0",
    "esbuild": "0.28.2",
    "jsdom": "30.1.2",
    "sharp": "0.34.5"
  }
}
